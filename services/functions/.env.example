ZAMAM_ALLOWED_ORIGINS=http://127.0.0.1:5173
CLIENT_PII_ENCRYPTION_KEY=base64-encoded-32-byte-local-key
CLIENT_PII_HASH_KEY=base64-encoded-32-byte-local-key
CLIENT_PII_KEY_VERSION=local-v1

# Backend-only file infrastructure. Never expose these names through VITE_*.
FILE_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=replace-with-account-id
R2_BUCKET_NAME=replace-with-private-bucket-name
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
MALWARE_SCANNER_PROVIDER=local
MALWARE_SCANNER_ENDPOINT=https://scanner.invalid
MALWARE_SCANNER_CREDENTIAL_REFERENCE=replace-with-secret-manager-reference

# Backend-only notification provider.
EMAIL_PROVIDER=local
RESEND_API_KEY=replace-with-email-api-key
EMAIL_FROM_ADDRESS=no-reply@example.invalid
ZAMAM_APP_BASE_URL=http://127.0.0.1:5173
